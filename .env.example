# ==============================================================================
# XClone Environment Configuration Template
# Copy this file to .env and configure with your local or production credentials
# ==============================================================================

# Application Profile
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=xclone_db
DB_USERNAME=xclone_user
DB_PASSWORD=xclone_password

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

